<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Memos.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Memos.Helpers"
    xmlns:vm="using:Memos.Core.ViewModels"
    Title="Memos">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root"
          AllowDrop="True"
          DragOver="OnDragOver"
          Drop="OnDrop"
          PreviewKeyDown="OnPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: tabs living in the title bar. The strip footer is the window's drag region. -->
        <TabView x:Name="Tabs"
                 VerticalAlignment="Stretch"
                 AddTabButtonClick="OnAddTabClick"
                 AllowDropTabs="True"
                 CanDragTabs="False"
                 CanReorderTabs="True"
                 CloseButtonOverlayMode="OnPointerOver"
                 IsAddTabButtonVisible="True"
                 SelectionChanged="OnTabSelectionChanged"
                 TabCloseRequested="OnTabCloseRequested"
                 TabDragCompleted="OnTabDragCompleted"
                 TabDragStarting="OnTabDragStarting"
                 TabItemsSource="{x:Bind ViewModel.Documents}"
                 TabWidthMode="SizeToContent">
            <TabView.TabStripHeader>
                <StackPanel Margin="14,0,8,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <Image Width="16" Height="16" Source="ms-appx:///Assets/Memos.ico" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="Memos" />
                </StackPanel>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid x:Name="TitleBarDragRegion" MinWidth="188" Background="Transparent" />
            </TabView.TabStripFooter>
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="vm:DocumentViewModel">
                    <TabViewItem AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}">
                        <TabViewItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                <!-- Unsaved changes -->
                                <Ellipse Width="7"
                                         Height="7"
                                         Margin="0,1,0,0"
                                         VerticalAlignment="Center"
                                         Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                         Visibility="{x:Bind h:Ui.Visible(IsModified), Mode=OneWay}" />
                            </StackPanel>
                        </TabViewItem.Header>
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="{x:Bind h:Ui.KindGlyph(Kind), Mode=OneWay}" />
                        </TabViewItem.IconSource>
                        <TabViewItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="{h:Loc Key=Tab_Close}" Click="OnTabMenuCloseClick" Tag="{x:Bind}" KeyboardAcceleratorTextOverride="Ctrl+W" />
                                <MenuFlyoutItem Text="{h:Loc Key=Tab_CloseOthers}" Click="OnTabMenuCloseOthersClick" Tag="{x:Bind}" />
                                <MenuFlyoutItem Text="{h:Loc Key=Tab_CloseRight}" Click="OnTabMenuCloseRightClick" Tag="{x:Bind}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="{h:Loc Key=Tab_CopyPath}" Click="OnTabMenuCopyPathClick" Tag="{x:Bind}" />
                                <MenuFlyoutItem Text="{h:Loc Key=Tab_Reveal}" Click="OnTabMenuRevealClick" Tag="{x:Bind}" />
                            </MenuFlyout>
                        </TabViewItem.ContextFlyout>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- Row 1: menus, the contextual toolbar and the workspace switch. -->
        <Grid Grid.Row="1" Height="{StaticResource ToolbarHeight}" Padding="4,0,8,0" ColumnSpacing="4" Visibility="{x:Bind h:Ui.Collapsed(ViewModel.IsSettingsOpen), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <MenuBar VerticalAlignment="Center">
                <MenuBarItem Title="{h:Loc Key=Menu_File}">
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_NewText}" Command="{x:Bind ViewModel.NewTextCommand}" KeyboardAcceleratorTextOverride="Ctrl+N">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_NewMarkdown}" Command="{x:Bind ViewModel.NewMarkdownCommand}" KeyboardAcceleratorTextOverride="Ctrl+Shift+N">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A1;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_NewRichText}" Command="{x:Bind ViewModel.NewRichTextCommand}" KeyboardAcceleratorTextOverride="Ctrl+Alt+N" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Open}" Command="{x:Bind ViewModel.OpenCommand}" KeyboardAcceleratorTextOverride="Ctrl+O">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem x:Name="RecentMenu" Text="{h:Loc Key=Cmd_Recent}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Save}" Command="{x:Bind ViewModel.SaveCommand}" KeyboardAcceleratorTextOverride="Ctrl+S">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_SaveAs}" Command="{x:Bind ViewModel.SaveAsCommand}" KeyboardAcceleratorTextOverride="Ctrl+Shift+S">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE792;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_SaveAll}" Command="{x:Bind ViewModel.SaveAllCommand}" KeyboardAcceleratorTextOverride="Ctrl+Alt+S" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Print}" Command="{x:Bind ViewModel.PrintCommand}" KeyboardAcceleratorTextOverride="Ctrl+P" />
                    <MenuFlyoutSubItem Text="{h:Loc Key=Cmd_Export}" IsEnabled="{x:Bind ViewModel.IsMarkdownActive, Mode=OneWay}">
                        <MenuFlyoutItem Text="{h:Loc Key=Cmd_ExportHtml}" Command="{x:Bind ViewModel.ExportHtmlCommand}" />
                        <MenuFlyoutItem Text="{h:Loc Key=Cmd_ExportPdf}" Command="{x:Bind ViewModel.ExportPdfCommand}" />
                        <MenuFlyoutItem Text="{h:Loc Key=Cmd_CopyHtml}" Command="{x:Bind ViewModel.CopyHtmlCommand}" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_CloseTab}" Command="{x:Bind ViewModel.CloseTabCommand}" KeyboardAcceleratorTextOverride="Ctrl+W" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_ReopenTab}" Command="{x:Bind ViewModel.ReopenClosedCommand}" KeyboardAcceleratorTextOverride="Ctrl+Shift+T" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Settings}" Command="{x:Bind ViewModel.OpenSettingsCommand}" KeyboardAcceleratorTextOverride="Ctrl+,">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Exit}" Command="{x:Bind ViewModel.ExitCommand}" KeyboardAcceleratorTextOverride="Alt+F4" />
                </MenuBarItem>

                <MenuBarItem Title="{h:Loc Key=Menu_Edit}">
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Undo}" Command="{x:Bind ViewModel.UndoCommand}" KeyboardAcceleratorTextOverride="Ctrl+Z">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Redo}" Command="{x:Bind ViewModel.RedoCommand}" KeyboardAcceleratorTextOverride="Ctrl+Y">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A6;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Cut}" Command="{x:Bind ViewModel.CutCommand}" KeyboardAcceleratorTextOverride="Ctrl+X">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C6;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Copy}" Command="{x:Bind ViewModel.CopyCommand}" KeyboardAcceleratorTextOverride="Ctrl+C">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Paste}" Command="{x:Bind ViewModel.PasteCommand}" KeyboardAcceleratorTextOverride="Ctrl+V">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_SelectAll}" Command="{x:Bind ViewModel.SelectAllCommand}" KeyboardAcceleratorTextOverride="Ctrl+A" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Find}" Command="{x:Bind ViewModel.FindCommand}" KeyboardAcceleratorTextOverride="Ctrl+F">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Replace}" Command="{x:Bind ViewModel.ReplaceCommand}" KeyboardAcceleratorTextOverride="Ctrl+H" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_FindInTabs}" Command="{x:Bind ViewModel.FindInTabsCommand}" KeyboardAcceleratorTextOverride="Ctrl+Shift+F" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_GoToLine}" Command="{x:Bind ViewModel.GoToLineCommand}" KeyboardAcceleratorTextOverride="Ctrl+G" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="{h:Loc Key=Menu_Lines}">
                        <MenuFlyoutItem Text="{h:Loc Key=Cmd_DuplicateLine}" Command="{x:Bind ViewModel.DuplicateLineCommand}" KeyboardAcceleratorTextOverride="Ctrl+D" />
                        <MenuFlyoutItem Text="{h:Loc Key=Cmd_DeleteLine}" Command="{x:Bind ViewModel.DeleteLineCommand}" KeyboardAcceleratorTextOverride="Ctrl+Shift+K" />
                        <MenuFlyoutItem Text="{h:Loc Key=Cmd_MoveLineUp}" Command="{x:Bind ViewModel.MoveLineUpCommand}" KeyboardAcceleratorTextOverride="Alt+↑" />
                        <MenuFlyoutItem Text="{h:Loc Key=Cmd_MoveLineDown}" Command="{x:Bind ViewModel.MoveLineDownCommand}" KeyboardAcceleratorTextOverride="Alt+↓" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="{h:Loc Key=Menu_Case}">
                        <MenuFlyoutItem Text="{h:Loc Key=Cmd_Uppercase}" Command="{x:Bind ViewModel.UppercaseCommand}" KeyboardAcceleratorTextOverride="Ctrl+Shift+U" />
                        <MenuFlyoutItem Text="{h:Loc Key=Cmd_Lowercase}" Command="{x:Bind ViewModel.LowercaseCommand}" KeyboardAcceleratorTextOverride="Ctrl+U" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="{h:Loc Key=Menu_Indentation}">
                        <MenuFlyoutItem Text="{h:Loc Key=Cmd_Indent}" Command="{x:Bind ViewModel.IndentCommand}" KeyboardAcceleratorTextOverride="Ctrl+]" />
                        <MenuFlyoutItem Text="{h:Loc Key=Cmd_Outdent}" Command="{x:Bind ViewModel.OutdentCommand}" KeyboardAcceleratorTextOverride="Ctrl+[" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="{h:Loc Key=Cmd_IndentToSpaces}" Command="{x:Bind ViewModel.IndentationToSpacesCommand}" />
                        <MenuFlyoutItem Text="{h:Loc Key=Cmd_IndentToTabs}" Command="{x:Bind ViewModel.IndentationToTabsCommand}" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_TrimTrailing}" Command="{x:Bind ViewModel.TrimTrailingWhitespaceCommand}" />
                </MenuBarItem>

                <MenuBarItem Title="{h:Loc Key=Menu_View}">
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_ZoomIn}" Command="{x:Bind ViewModel.ZoomInCommand}" KeyboardAcceleratorTextOverride="Ctrl++">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A3;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_ZoomOut}" Command="{x:Bind ViewModel.ZoomOutCommand}" KeyboardAcceleratorTextOverride="Ctrl+-">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71F;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_ZoomReset}" Command="{x:Bind ViewModel.ResetZoomCommand}" KeyboardAcceleratorTextOverride="Ctrl+0" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem Text="{h:Loc Key=Cmd_WordWrap}" IsChecked="{x:Bind ViewModel.Settings.WordWrap, Mode=TwoWay}" KeyboardAcceleratorTextOverride="Alt+Z" />
                    <ToggleMenuFlyoutItem Text="{h:Loc Key=Cmd_LineNumbers}" IsChecked="{x:Bind ViewModel.Settings.ShowLineNumbers, Mode=TwoWay}" />
                    <ToggleMenuFlyoutItem Text="{h:Loc Key=Cmd_Invisibles}" IsChecked="{x:Bind ViewModel.Settings.ShowInvisibles, Mode=TwoWay}" />
                    <ToggleMenuFlyoutItem Text="{h:Loc Key=Cmd_StatusBar}" IsChecked="{x:Bind ViewModel.Settings.ShowStatusBar, Mode=TwoWay}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="ViewEditorMenuItem" Text="{h:Loc Key=Cmd_ViewEditor}" Click="OnViewModeClick" Tag="Editor" IsEnabled="{x:Bind ViewModel.IsMarkdownActive, Mode=OneWay}" />
                    <MenuFlyoutItem x:Name="ViewSplitMenuItem" Text="{h:Loc Key=Cmd_ViewSplit}" Click="OnViewModeClick" Tag="Split" IsEnabled="{x:Bind ViewModel.IsMarkdownActive, Mode=OneWay}" />
                    <MenuFlyoutItem x:Name="ViewPreviewMenuItem" Text="{h:Loc Key=Cmd_ViewPreview}" Click="OnViewModeClick" Tag="Preview" IsEnabled="{x:Bind ViewModel.IsMarkdownActive, Mode=OneWay}" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Outline}" Command="{x:Bind ViewModel.ToggleOutlineCommand}" />
                </MenuBarItem>

                <MenuBarItem x:Name="FormatMenu" Title="{h:Loc Key=Menu_Format}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <MenuFlyoutSubItem x:Name="HeadingMenu" Text="{h:Loc Key=Cmd_Heading}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Bold}" Command="{x:Bind ViewModel.BoldCommand}" KeyboardAcceleratorTextOverride="Ctrl+B" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Italic}" Command="{x:Bind ViewModel.ItalicCommand}" KeyboardAcceleratorTextOverride="Ctrl+I" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Strikethrough}" Command="{x:Bind ViewModel.StrikethroughCommand}" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_InlineCode}" Command="{x:Bind ViewModel.InlineCodeCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Link}" Command="{x:Bind ViewModel.LinkCommand}" KeyboardAcceleratorTextOverride="Ctrl+K" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Image}" Command="{x:Bind ViewModel.ImageCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_BulletList}" Command="{x:Bind ViewModel.BulletListCommand}" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_NumberedList}" Command="{x:Bind ViewModel.NumberedListCommand}" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_TaskList}" Command="{x:Bind ViewModel.TaskListCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Quote}" Command="{x:Bind ViewModel.QuoteCommand}" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_CodeBlock}" Command="{x:Bind ViewModel.CodeBlockCommand}" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Table}" Click="OnInsertDefaultTableClick" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_HorizontalRule}" Command="{x:Bind ViewModel.HorizontalRuleCommand}" />
                </MenuBarItem>
                <!-- Text workspace: formatting is a switch of the same editor, not a workspace of its own. -->
                <MenuBarItem Title="{h:Loc Key=Menu_Format}" Visibility="{x:Bind h:Ui.Collapsed(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <ToggleMenuFlyoutItem x:Name="FormattingMenuItem" Text="{h:Loc Key=Cmd_Formatting}" Click="OnFormattingClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Bold}" Command="{x:Bind ViewModel.BoldCommand}" KeyboardAcceleratorTextOverride="Ctrl+B" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Italic}" Command="{x:Bind ViewModel.ItalicCommand}" KeyboardAcceleratorTextOverride="Ctrl+I" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Underline}" Command="{x:Bind ViewModel.UnderlineCommand}" KeyboardAcceleratorTextOverride="Ctrl+U" />
                    <MenuFlyoutItem Text="{h:Loc Key=Cmd_Strikethrough}" Command="{x:Bind ViewModel.StrikethroughCommand}" />
                </MenuBarItem>
            </MenuBar>

            <CommandBar Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        DefaultLabelPosition="Collapsed"
                        IsDynamicOverflowEnabled="True"
                        IsOpen="False">
                <AppBarButton Label="{h:Loc Key=Cmd_Open}" ToolTipService.ToolTip="{h:Loc Key=Tip_Open}" Command="{x:Bind ViewModel.OpenCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_Save}" ToolTipService.ToolTip="{h:Loc Key=Tip_Save}" Command="{x:Bind ViewModel.SaveCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="{h:Loc Key=Cmd_Undo}" ToolTipService.ToolTip="{h:Loc Key=Tip_Undo}" Command="{x:Bind ViewModel.UndoCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7A7;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_Redo}" ToolTipService.ToolTip="{h:Loc Key=Tip_Redo}" Command="{x:Bind ViewModel.RedoCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7A6;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_Find}" ToolTipService.ToolTip="{h:Loc Key=Tip_Find}" Command="{x:Bind ViewModel.FindCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE721;" /></AppBarButton.Icon>
                </AppBarButton>

                <!-- Text workspace: the formatting switch and, while it is on, the character styles. -->
                <AppBarSeparator Visibility="{x:Bind h:Ui.Collapsed(ViewModel.IsMarkdownActive), Mode=OneWay}" />
                <AppBarToggleButton x:Name="FormattingButton" Label="{h:Loc Key=Cmd_Formatting}" ToolTipService.ToolTip="{h:Loc Key=Tip_Formatting}" Click="OnFormattingClick" Visibility="{x:Bind h:Ui.Collapsed(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8D2;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton Label="{h:Loc Key=Cmd_Bold}" Command="{x:Bind ViewModel.BoldCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsRichTextActive), Mode=OneWay}"><AppBarButton.Icon><FontIcon Glyph="&#xE8DD;" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_Italic}" Command="{x:Bind ViewModel.ItalicCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsRichTextActive), Mode=OneWay}"><AppBarButton.Icon><FontIcon Glyph="&#xE8DB;" /></AppBarButton.Icon></AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_Underline}" Command="{x:Bind ViewModel.UnderlineCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsRichTextActive), Mode=OneWay}"><AppBarButton.Icon><FontIcon Glyph="&#xE8DC;" /></AppBarButton.Icon></AppBarButton>

                <!-- Markdown workspace -->
                <AppBarSeparator Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}" />
                <AppBarButton x:Name="HeadingButton" Label="{h:Loc Key=Cmd_Heading}" ToolTipService.ToolTip="{h:Loc Key=Cmd_Heading}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8E9;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="HeadingFlyout" Placement="Bottom" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_Bold}" ToolTipService.ToolTip="{h:Loc Key=Tip_Bold}" Command="{x:Bind ViewModel.BoldCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8DD;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_Italic}" ToolTipService.ToolTip="{h:Loc Key=Tip_Italic}" Command="{x:Bind ViewModel.ItalicCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8DB;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_Strikethrough}" ToolTipService.ToolTip="{h:Loc Key=Cmd_Strikethrough}" Command="{x:Bind ViewModel.StrikethroughCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xEDE0;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_InlineCode}" ToolTipService.ToolTip="{h:Loc Key=Cmd_InlineCode}" Command="{x:Bind ViewModel.InlineCodeCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE943;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}" />
                <AppBarButton Label="{h:Loc Key=Cmd_Link}" ToolTipService.ToolTip="{h:Loc Key=Tip_Link}" Command="{x:Bind ViewModel.LinkCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE71B;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_Image}" ToolTipService.ToolTip="{h:Loc Key=Cmd_Image}" Command="{x:Bind ViewModel.ImageCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B9;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_BulletList}" ToolTipService.ToolTip="{h:Loc Key=Cmd_BulletList}" Command="{x:Bind ViewModel.BulletListCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8FD;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_NumberedList}" ToolTipService.ToolTip="{h:Loc Key=Cmd_NumberedList}" Command="{x:Bind ViewModel.NumberedListCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon FontFamily="{ThemeResource ContentControlThemeFontFamily}" FontSize="13" FontWeight="SemiBold" Glyph="1." /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_TaskList}" ToolTipService.ToolTip="{h:Loc Key=Cmd_TaskList}" Command="{x:Bind ViewModel.TaskListCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE9D5;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_Quote}" ToolTipService.ToolTip="{h:Loc Key=Cmd_Quote}" Command="{x:Bind ViewModel.QuoteCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon FontFamily="{ThemeResource ContentControlThemeFontFamily}" FontSize="20" FontWeight="SemiBold" Glyph="&#x201D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_CodeBlock}" ToolTipService.ToolTip="{h:Loc Key=Cmd_CodeBlock}" Command="{x:Bind ViewModel.CodeBlockCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon FontFamily="{ThemeResource ContentControlThemeFontFamily}" FontSize="12" FontWeight="SemiBold" Glyph="{}{ }" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="TableButton" Label="{h:Loc Key=Cmd_Table}" ToolTipService.ToolTip="{h:Loc Key=Cmd_Table}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xF0E2;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <Flyout x:Name="TableFlyout" Placement="Bottom">
                            <StackPanel Width="220" Spacing="12">
                                <NumberBox x:Name="TableRowsBox" Header="{h:Loc Key=Table_Rows}" Minimum="1" Maximum="50" Value="3" SpinButtonPlacementMode="Inline" />
                                <NumberBox x:Name="TableColumnsBox" Header="{h:Loc Key=Table_Columns}" Minimum="1" Maximum="20" Value="3" SpinButtonPlacementMode="Inline" />
                                <Button HorizontalAlignment="Stretch" Content="{h:Loc Key=Table_Insert}" Click="OnInsertTableClick" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Label="{h:Loc Key=Cmd_HorizontalRule}" ToolTipService.ToolTip="{h:Loc Key=Cmd_HorizontalRule}" Command="{x:Bind ViewModel.HorizontalRuleCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE949;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}" />
                <AppBarToggleButton x:Name="ViewEditorButton" Label="{h:Loc Key=Cmd_ViewEditor}" ToolTipService.ToolTip="{h:Loc Key=Cmd_ViewEditor}" Click="OnViewModeClick" Tag="Editor" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="ViewSplitButton" Label="{h:Loc Key=Cmd_ViewSplit}" ToolTipService.ToolTip="{h:Loc Key=Cmd_ViewSplit}" Click="OnViewModeClick" Tag="Split" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE89A;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="ViewPreviewButton" Label="{h:Loc Key=Cmd_ViewPreview}" ToolTipService.ToolTip="{h:Loc Key=Cmd_ViewPreview}" Click="OnViewModeClick" Tag="Preview" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE890;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="OutlineButton" Label="{h:Loc Key=Cmd_Outline}" ToolTipService.ToolTip="{h:Loc Key=Cmd_Outline}" Click="OnOutlineClick" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8BC;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton Label="{h:Loc Key=Cmd_Export}" ToolTipService.ToolTip="{h:Loc Key=Cmd_Export}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="{h:Loc Key=Cmd_ExportHtml}" Command="{x:Bind ViewModel.ExportHtmlCommand}" />
                            <MenuFlyoutItem Text="{h:Loc Key=Cmd_ExportPdf}" Command="{x:Bind ViewModel.ExportPdfCommand}" />
                            <MenuFlyoutItem Text="{h:Loc Key=Cmd_CopyHtml}" Command="{x:Bind ViewModel.CopyHtmlCommand}" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>

            <!-- Which editor the active tab uses. Opening a file picks it automatically. -->
            <SelectorBar x:Name="WorkspaceSelector"
                         Grid.Column="2"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="{h:Loc Key=Workspace_Name}"
                         SelectionChanged="OnWorkspaceSelectionChanged">
                <SelectorBarItem x:Name="TextWorkspaceItem" Text="{h:Loc Key=Workspace_Text}">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE8A5;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="MarkdownWorkspaceItem" Text="{h:Loc Key=Workspace_Markdown}">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE8A1;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <Button Grid.Column="3"
                    Style="{StaticResource IconButtonStyle}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{h:Loc Key=Cmd_Settings}"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    ToolTipService.ToolTip="{h:Loc Key=Cmd_Settings}">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Row 2: the editing surface. One DocumentView per tab; only the active one is visible. -->
        <Border Grid.Row="2"
                Margin="0"
                Visibility="{x:Bind h:Ui.Collapsed(ViewModel.IsSettingsOpen), Mode=OneWay}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="DocumentHost" />
                <Grid x:Name="GlobalSearchHost" Grid.Row="1" />
            </Grid>
        </Border>

        <!-- Row 3: status bar -->
        <Grid x:Name="StatusBar"
              Grid.Row="3"
              Height="{StaticResource StatusBarHeight}"
              Padding="6,0"
              Visibility="{x:Bind h:Ui.VisibleUnless(ViewModel.Settings.ShowStatusBar, ViewModel.IsSettingsOpen), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PositionButton"
                        Style="{StaticResource StatusBarButtonStyle}"
                        Command="{x:Bind ViewModel.GoToLineCommand}"
                        Content="{x:Bind h:Ui.Position(ViewModel.ActiveDocument.Line, ViewModel.ActiveDocument.Column), Mode=OneWay}"
                        ToolTipService.ToolTip="{h:Loc Key=Cmd_GoToLine}" />
                <TextBlock x:Name="CharactersText" Style="{StaticResource StatusBarTextStyle}" Text="{x:Bind h:Ui.Characters(ViewModel.ActiveDocument.CharacterCount), Mode=OneWay}" />
                <TextBlock x:Name="WordsText" Style="{StaticResource StatusBarTextStyle}" Text="{x:Bind h:Ui.Words(ViewModel.ActiveDocument.WordCount), Mode=OneWay}" />
                <TextBlock Style="{StaticResource StatusBarTextStyle}"
                           Text="{x:Bind h:Ui.ReadingTime(ViewModel.ActiveDocument.ReadingMinutes), Mode=OneWay}"
                           Visibility="{x:Bind h:Ui.Visible(ViewModel.IsMarkdownActive), Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="InsertModeButton"
                        Style="{StaticResource StatusBarButtonStyle}"
                        Visibility="{x:Bind h:Ui.Collapsed(ViewModel.IsRichTextActive), Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleOverwriteCommand}"
                        Content="{x:Bind h:Ui.InsertMode(ViewModel.ActiveDocument.IsOverwrite), Mode=OneWay}"
                        ToolTipService.ToolTip="{h:Loc Key=Status_InsertMode}"
                        AutomationProperties.HelpText="{h:Loc Key=Status_InsertMode}" />
                <Button x:Name="ZoomButton"
                        Style="{StaticResource StatusBarButtonStyle}"
                        Visibility="{x:Bind h:Ui.Collapsed(ViewModel.IsRichTextActive), Mode=OneWay}"
                        Content="{x:Bind h:Ui.Percent(ViewModel.ActiveDocument.ZoomPercent), Mode=OneWay}"
                        ToolTipService.ToolTip="{h:Loc Key=Status_Zoom}"
                        AutomationProperties.HelpText="{h:Loc Key=Status_Zoom}">
                    <Button.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem Text="{h:Loc Key=Cmd_ZoomIn}" Command="{x:Bind ViewModel.ZoomInCommand}" KeyboardAcceleratorTextOverride="Ctrl++" />
                            <MenuFlyoutItem Text="{h:Loc Key=Cmd_ZoomOut}" Command="{x:Bind ViewModel.ZoomOutCommand}" KeyboardAcceleratorTextOverride="Ctrl+-" />
                            <MenuFlyoutItem Text="{h:Loc Key=Cmd_ZoomReset}" Command="{x:Bind ViewModel.ResetZoomCommand}" KeyboardAcceleratorTextOverride="Ctrl+0" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="LineEndingButton"
                        Style="{StaticResource StatusBarButtonStyle}"
                        Visibility="{x:Bind h:Ui.Collapsed(ViewModel.IsRichTextActive), Mode=OneWay}"
                        Content="{x:Bind h:Ui.LineEndingName(ViewModel.ActiveDocument.LineEnding), Mode=OneWay}"
                        ToolTipService.ToolTip="{h:Loc Key=Status_LineEnding}"
                        AutomationProperties.HelpText="{h:Loc Key=Status_LineEnding}">
                    <Button.Flyout>
                        <MenuFlyout x:Name="LineEndingFlyout" Placement="Top" Opening="OnLineEndingFlyoutOpening" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="EncodingButton"
                        Style="{StaticResource StatusBarButtonStyle}"
                        Visibility="{x:Bind h:Ui.Collapsed(ViewModel.IsRichTextActive), Mode=OneWay}"
                        Content="{x:Bind h:Ui.EncodingName(ViewModel.ActiveDocument.Encoding), Mode=OneWay}"
                        ToolTipService.ToolTip="{h:Loc Key=Status_Encoding}"
                        AutomationProperties.HelpText="{h:Loc Key=Status_Encoding}">
                    <Button.Flyout>
                        <MenuFlyout x:Name="EncodingFlyout" Placement="Top" Opening="OnEncodingFlyoutOpening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Settings cover the workspace below the title bar. -->
        <Grid x:Name="SettingsHost" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" />

        <!-- Invisible home for the pages being printed or exported to PDF. -->
        <Canvas x:Name="HiddenHost" Width="0" Height="0" IsHitTestVisible="False" Opacity="0" />
    </Grid>
</Window>
