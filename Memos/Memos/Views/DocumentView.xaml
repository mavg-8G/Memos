<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Memos.Views.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Memos.Helpers"
    xmlns:md="using:Memos.Core.Markdown"
    xmlns:views="using:Memos.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Warnings about this document: encoding guesses, mixed line endings, external changes. -->
        <InfoBar x:Name="NoticeBar" Closed="OnNoticeClosed" />

        <!-- Find and replace -->
        <Grid x:Name="FindBar"
              Grid.Row="1"
              Padding="12,6"
              ColumnSpacing="4"
              RowSpacing="6"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Visibility="{x:Bind h:Ui.Visible(Document.Find.IsVisible), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                          IsChecked="{x:Bind Document.Find.IsReplaceVisible, Mode=TwoWay}"
                          AutomationProperties.Name="{h:Loc Key=Find_ToggleReplace}"
                          ToolTipService.ToolTip="{h:Loc Key=Find_ToggleReplace}">
                <FontIcon Glyph="&#xE8AB;" FontSize="14" />
            </ToggleButton>

            <TextBox x:Name="QueryBox"
                     Grid.Column="1"
                     PlaceholderText="{h:Loc Key=Find_Placeholder}"
                     AutomationProperties.Name="{h:Loc Key=Find_Placeholder}"
                     Text="{x:Bind Document.Find.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsSpellCheckEnabled="False"
                     KeyDown="OnQueryKeyDown" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                              IsChecked="{x:Bind Document.Find.MatchCase, Mode=TwoWay}"
                              AutomationProperties.Name="{h:Loc Key=Find_MatchCase}"
                              ToolTipService.ToolTip="{h:Loc Key=Find_MatchCase}">
                    <TextBlock Text="Aa" FontSize="13" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                              IsChecked="{x:Bind Document.Find.WholeWord, Mode=TwoWay}"
                              AutomationProperties.Name="{h:Loc Key=Find_WholeWord}"
                              ToolTipService.ToolTip="{h:Loc Key=Find_WholeWord}">
                    <TextBlock Text="ab" FontSize="13" TextDecorations="Underline" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                              IsChecked="{x:Bind Document.Find.UseRegex, Mode=TwoWay}"
                              AutomationProperties.Name="{h:Loc Key=Find_Regex}"
                              ToolTipService.ToolTip="{h:Loc Key=Find_Regex}">
                    <TextBlock Text=".*" FontSize="13" />
                </ToggleButton>
                <Button Style="{StaticResource IconButtonStyle}"
                        Click="OnFindPreviousClick"
                        AutomationProperties.Name="{h:Loc Key=Find_Previous}"
                        ToolTipService.ToolTip="{h:Loc Key=Find_Previous}">
                    <FontIcon Glyph="&#xE70E;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}"
                        Click="OnFindNextClick"
                        AutomationProperties.Name="{h:Loc Key=Find_Next}"
                        ToolTipService.ToolTip="{h:Loc Key=Find_Next}">
                    <FontIcon Glyph="&#xE70D;" FontSize="14" />
                </Button>
            </StackPanel>

            <TextBlock x:Name="FindStatus"
                       Grid.Column="3"
                       Margin="8,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       AutomationProperties.LiveSetting="Polite"
                       Text="{x:Bind Document.Find.StatusText, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="4"
                    Style="{StaticResource IconButtonStyle}"
                    Click="OnFindCloseClick"
                    AutomationProperties.Name="{h:Loc Key=Find_Close}"
                    ToolTipService.ToolTip="{h:Loc Key=Find_Close}">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>

            <TextBox x:Name="ReplaceBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     PlaceholderText="{h:Loc Key=Find_ReplacePlaceholder}"
                     AutomationProperties.Name="{h:Loc Key=Find_ReplacePlaceholder}"
                     Text="{x:Bind Document.Find.Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsSpellCheckEnabled="False"
                     KeyDown="OnReplaceKeyDown"
                     Visibility="{x:Bind h:Ui.Visible(Document.Find.IsReplaceVisible), Mode=OneWay}" />
            <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Spacing="4"
                        Visibility="{x:Bind h:Ui.Visible(Document.Find.IsReplaceVisible), Mode=OneWay}">
                <Button Content="{h:Loc Key=Find_Replace}" Click="OnReplaceClick" />
                <Button Content="{h:Loc Key=Find_ReplaceAll}" Click="OnReplaceAllClick" />
            </StackPanel>
        </Grid>

        <Grid x:Name="Body" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <views:EditorControl x:Name="Editor" />

            <!-- Drag to change how the width is shared between source and preview. -->
            <views:SplitterHandle x:Name="Splitter"
                                  Grid.Column="1"
                                  Width="9"
                                  Background="Transparent"
                                  PointerPressed="OnSplitterPressed"
                                  PointerMoved="OnSplitterMoved"
                                  PointerReleased="OnSplitterReleased"
                                  PointerCaptureLost="OnSplitterCaptureLost"
                                  AutomationProperties.AccessibilityView="Raw">
                <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </views:SplitterHandle>

            <views:MarkdownPreview x:Name="Preview" Grid.Column="2" />

            <!-- Table of contents -->
            <Grid x:Name="Outline"
                  Grid.Column="3"
                  Width="250"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="16,12,12,8" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{h:Loc Key=Outline_Title}" />
                <TextBlock x:Name="OutlineEmpty"
                           Grid.Row="1"
                           Margin="16,4,12,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{h:Loc Key=Outline_Empty}"
                           TextWrapping="Wrap" />
                <ListView x:Name="OutlineList"
                          Grid.Row="1"
                          AutomationProperties.Name="{h:Loc Key=Outline_Title}"
                          IsItemClickEnabled="True"
                          ItemClick="OnOutlineItemClick"
                          ItemsSource="{x:Bind Document.Headings, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="md:HeadingInfo">
                            <TextBlock Margin="{x:Bind h:Ui.OutlineMargin(Level)}"
                                       Text="{x:Bind Text}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind Text}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
